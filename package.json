{
    "name": "sc-game-base-view-module",
    "version": "1.0.1-beta.10",
    "description": "Reusable view components for sc-game-base",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "scripts": {
        "setup": "npm install",
        "build": "npm run setup && node ./node_modules/typescript/bin/tsc --project tsconfig.json",
        "clean": "rimraf dist",
        "reg": "npm set registry http://npm.lumigame.com",
        "pub": "npm publish --registry http://npm.lumigame.com",
        "pub:beta": "npm publish --tag beta --registry http://npm.lumigame.com",
        "version:beta": "npm version prerelease --preid beta",
        "release:beta": "npm run build && npm run version:beta && npm run pub:beta",
        "semantic-release": "semantic-release",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "test:mutation": "stryker run",
        "install-deps": "npm install && npm install --save-peer"
    },
    "repository": {
        "type": "git",
        "url": "https://git3.nexdev.net/l1/game-services/sc-game-base-view-module.git"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "dependencies": {
        "rimraf": "^5.0.5",
        "sc-game-base": "4.1.0",
        "socket.io": "^4.0.0"
    },
    "devDependencies": {
        "@babel/core": "^7.0.0",
        "@babel/preset-env": "^7.12.11",
        "@babel/preset-typescript": "^7.23.3",
        "@stryker-mutator/core": "^8.2.0",
        "@stryker-mutator/jest-runner": "^8.2.0",
        "@stryker-mutator/typescript-checker": "^8.2.0",
        "@types/jest": "^29.5.0",
        "@types/sc-common": "^1.0.0-beta.0",
        "@types/sc-game-base": "^1.0.0-beta.6",
        "@types/sc-base-database": "^1.0.0-beta.0",
        "@types/node": "^20.11.17",
        "@types/socket.io": "^3.0.2",
        "babel-jest": "^29.5.0",
        "jest": "^29.5.0",
        "jest-extended": "^4.0.0",
        "jest-junit": "^16.0.0",
        "jest-micro-auto-stub": "^1.0.9",
        "jest-sonar-reporter": "^2.0.0",
        "ts-jest": "^29.1.0",
        "typescript": "^5.3.3"
    }
}