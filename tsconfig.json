{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "lib": [
            "ES2020"
        ],
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "moduleResolution": "node",
        "baseUrl": "./",
        "allowJs": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": [
            "jest",
            "node"
        ]
    },
    "include": [
        "src/**/*",
        "tests/unit-tests/index.test.ts",
        "tests/unit-tests/event-publishers/round-result-publisher.test.ts",
        "tests/unit-tests/consumers/view-consumer.test.ts",
        "tests/unit-tests/event-publishers/game-status-publisher.test.ts",
        "tests/unit-tests/routers/base-view-router.test.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "tests"
    ]
}